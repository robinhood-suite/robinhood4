        "id": 1019048
      },
      "writtenOn": "2026-07-29T09:41:41Z",
      "side": 1,
      "message": "OK I see. So does that mean that default ACLs do not matter for regular files ?",
      "parentUuid": "09e72c4b_c5bd61e5",
      "range": {
        "startLine": 64,
        "startChar": 4,
        "endLine": 70,
        "endChar": 11
