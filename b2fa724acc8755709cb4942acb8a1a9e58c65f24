    {
      "unresolved": true,
      "key": {
        "uuid": "09e72c4b_c5bd61e5",
        "filename": "rbh-sync/tests/acl/test_acl_db_sync.bash",
        "patchSetId": 4
      },
      "lineNbr": 70,
      "author": {
        "id": 1039469
      },
      "writtenOn": "2026-07-29T09:30:26Z",
      "side": 1,
      "message": "Here, the access ACL applies to the directory itself. The default ACL is used as a template for the permissions of new files and directories created inside it.\n\nThey contain the same kind of entries, but they are stored and used separately.\nSo nothing is ignored, it depends on the usecase",
      "parentUuid": "1bee4375_1751e092",
      "range": {
        "startLine": 64,
        "startChar": 4,
        "endLine": 70,
        "endChar": 11
      },
      "revId": "b2fa724acc8755709cb4942acb8a1a9e58c65f24",
      "serverId": "d5d70762-12d0-45a1-890d-524b12d3f735"
    },
